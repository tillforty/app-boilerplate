# ── App Postgres database ───────────────────────────────────────────────
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/app

# ── Auth (API login / JWT) ──────────────────────────────────────────────
# JWT_SECRET signs login tokens — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=720

# Initial user seeded on API startup if it doesn't exist (no public registration).
SEED_USER_NAME=Admin
SEED_USER_SURNAME=User
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=CHANGE_ME

# ── Encrypted vault (pgcrypto) ──────────────────────────────────────────
# VAULT_KEY encrypts secrets stored via the vault (pgp_sym_encrypt).
VAULT_KEY=CHANGE_ME

# ── File storage ────────────────────────────────────────────────────────
# Bind-mount this to a persistent volume so uploaded binaries survive restarts.
STORAGE_DIR=/srv/storage
