# ── App Postgres database ───────────────────────────────────────────────
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/app

# ── Auth (API login / JWT) ──────────────────────────────────────────────
# JWT_SECRET signs login tokens — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=720
# How long invite links stay valid (hours). Default 72.
INVITE_EXPIRE_HOURS=72

# Initial user seeded on API startup if it doesn't exist (no public registration).
SEED_USER_NAME=Admin
SEED_USER_SURNAME=User
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=CHANGE_ME

# ── Demo mode (optional) ────────────────────────────────────────────────
# When true, a low-privilege demo user (member role) is seeded on startup and
# its credentials are shown on the login screen (GET /auth/demo advertises them).
# For public showcases only — NEVER enable on an instance with real data.
DEMO_MODE=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo

# ── Encrypted vault (pgcrypto) ──────────────────────────────────────────
# VAULT_KEY encrypts secrets stored via the vault (pgp_sym_encrypt).
VAULT_KEY=CHANGE_ME

# ── File storage ────────────────────────────────────────────────────────
# STORAGE_TYPE=local  → binaries saved on disk under STORAGE_DIR (default).
# STORAGE_TYPE=backblaze → binaries stored in Backblaze B2 (set B2_* below).
STORAGE_TYPE=local
# Bind-mount this to a persistent volume so uploaded binaries survive restarts.
# Only used when STORAGE_TYPE=local.
STORAGE_DIR=/srv/storage
# Backblaze B2 credentials — only required when STORAGE_TYPE=backblaze.
# B2_ENDPOINT_URL format: https://s3.<region>.backblazeb2.com (e.g. us-west-004)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=

# ── LLM: embedding model ────────────────────────────────────────────────
# EMBEDDING_DIM MUST match the model's output dimension (3-small = 1536).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_BASE_URL=

# ── LLM: operating agent model ──────────────────────────────────────────
# LLM that powers the operating agent (reasoning / chat / tool use).
OPERATING_AGENT_MODEL=gpt-4o
OPERATING_AGENT_API_KEY=CHANGE_ME
OPERATING_AGENT_BASE_URL=

# ── OAuth / SSO (optional) ──────────────────────────────────────────────
# Set a provider's CLIENT_ID + CLIENT_SECRET to show its button on the login
# screen. Callback URI = {OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/{provider}/callback
# Point this at the entry point that serves /api (the nginx/web proxy), not the
# direct API port — otherwise the /api prefix won't resolve and the callback 404s.
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
OAUTH_POST_LOGIN_URL=/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── SMTP / outbound email (optional) ────────────────────────────────────
# Transactional email (password resets, invites, notifications). Leave
# SMTP_HOST blank to disable sending (mailer no-ops). For Gmail/Workspace use
# an App Password, not the account password.
SMTP_HOST=
# 587 = STARTTLS (most common), 465 = implicit TLS/SSL, 25 = unencrypted relay.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Use STARTTLS (true for port 587). Set false + SMTP_SSL=true for port 465.
SMTP_STARTTLS=true
SMTP_SSL=false
# Envelope/from address shown to recipients (defaults to SMTP_USERNAME if blank).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tillforty

# ── n8n (optional) ──────────────────────────────────────────────────────
# Webhook URLs come from env, never hardcoded (see backend/app/n8n.py).
# Leave blank to disable n8n calls (helpers no-op).
N8N_BASE_URL=
# Base for production webhooks; defaults to {N8N_BASE_URL}/webhook when blank.
N8N_WEBHOOK_URL=
