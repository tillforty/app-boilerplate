# ─────────────────────────────────────────────────────────────────────────────
# Tillforty App Boilerplate — environment template
# Copy to `.env` and replace every CHANGE_ME. Never commit the filled-in .env.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Public deployment (optional) ────────────────────────────────────────
# Set DOMAIN to serve the app publicly over HTTPS. start.sh then enables the
# Caddy reverse proxy (compose `public` profile), which auto-provisions a
# Let's Encrypt cert and proxies :443 -> the web container. Requires the host's
# ports 80/443 to be free and DNS for DOMAIN pointed at this server. See DEPLOY.md.
# Leave DOMAIN blank for a local-only run (app stays on http://localhost:WEB_PORT).
DOMAIN=
# Contact email for Let's Encrypt expiry/issue notices (recommended in prod).
ACME_EMAIL=
# Origin TLS strategy for the Caddy proxy:
#   (blank)        — automatic Let's Encrypt; use when this server is directly
#                    internet-facing and DNS for DOMAIN points straight here.
#   tls internal   — Caddy serves a self-signed cert on :443. Use when DOMAIN
#                    sits behind a TLS-terminating proxy (e.g. Cloudflare with
#                    orange-cloud + SSL/TLS mode "Full"): the edge validates the
#                    cert loosely, so no public-facing ACME/port-80 is needed.
#   tls /path/fullchain.pem /path/privkey.pem — a custom or origin certificate.
CADDY_TLS=
# When DOMAIN is set, also set OAUTH_REDIRECT_BASE_URL below to https://DOMAIN.

# ── Postgres ────────────────────────────────────────────────────────────
# Full DSN the API connects with. Host is the service/container name.
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/app
# Used by the postgres container/image to provision the above on first boot.
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app

# ── Auth (API login / JWT) ──────────────────────────────────────────────
# JWT_SECRET signs login tokens — openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# Token lifetime in minutes (720 = 12h).
JWT_EXPIRE_MINUTES=720
# How long user invitation links stay valid (days). Default 7.
INVITE_EXPIRE_DAYS=7
# Initial user seeded on API startup if it doesn't exist (no public registration).
SEED_USER_NAME=Admin
SEED_USER_SURNAME=User
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=CHANGE_ME

# ── Demo mode (optional) ────────────────────────────────────────────────
# When true, a low-privilege demo user (member role) is seeded on startup and
# its credentials are shown on the login screen (GET /auth/demo advertises them).
# For public showcases only — NEVER enable on an instance with real data.
DEMO_MODE=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo

# ── Encrypted vault (pgcrypto) ──────────────────────────────────────────
# VAULT_KEY symmetrically encrypts readable secrets (pgp_sym_encrypt).
# WARNING: rotating this makes existing vault_secrets undecryptable.
VAULT_KEY=CHANGE_ME

# ── File storage ────────────────────────────────────────────────────────
# STORAGE_TYPE=local  → binaries saved on disk under STORAGE_DIR (default).
# STORAGE_TYPE=backblaze → binaries stored in Backblaze B2 (set B2_* below).
STORAGE_TYPE=local
# Bind-mount to a persistent volume so uploaded binaries survive restarts.
# Only used when STORAGE_TYPE=local.
STORAGE_DIR=/srv/storage
# Backblaze B2 credentials — only required when STORAGE_TYPE=backblaze.
# Create an application key at https://secure.backblaze.com/app_keys.htm
# B2_ENDPOINT_URL format: https://s3.<region>.backblazeb2.com (e.g. us-west-004)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=

# ── LLM: embedding model ────────────────────────────────────────────────
# Turns text into vectors for the pgvector store. EMBEDDING_DIM MUST match the
# model's output dimension (text-embedding-3-small = 1536).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=CHANGE_ME
# Optional: override the provider base URL (e.g. Azure / a proxy / self-hosted).
EMBEDDING_BASE_URL=

# ── LLM: operating agent model ──────────────────────────────────────────
# LLM that powers the operating agent (reasoning / chat / tool use).
OPERATING_AGENT_MODEL=gpt-4o
OPERATING_AGENT_API_KEY=CHANGE_ME
# Optional: override the provider base URL.
OPERATING_AGENT_BASE_URL=

# ── OAuth / SSO (optional) ──────────────────────────────────────────────
# Set a provider's CLIENT_ID + CLIENT_SECRET to enable its button on the login
# screen. Leave a provider blank to hide its button entirely.
# Public base URL the provider redirects back to (no trailing slash). This MUST
# be the web entry point (the nginx service), NOT the direct API port — it both
# proxies /api to the backend and serves the SPA's /auth/callback route. Register
#   {OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/{google|microsoft}/callback
# as the redirect URI in the provider console. In production set it to your
# public https URL (e.g. https://app.example.com).
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
# SPA route the backend redirects to after success (reads token from #fragment).
OAUTH_POST_LOGIN_URL=/auth/callback
# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID) — https://portal.azure.com app registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Outbound email (optional) ───────────────────────────────────────────
# Transactional email (password resets, invites, notifications). Two transports,
# tried in order — leave both unset to disable sending (mailer no-ops):
#   1. Resend HTTP API — set RESEND_API_KEY (preferred; sends logged in Resend).
#   2. SMTP — set SMTP_HOST (any provider, incl. Resend's SMTP bridge below).
# SMTP_FROM_EMAIL / SMTP_FROM_NAME set the From identity for BOTH transports and
# must be on a domain verified in Resend (e.g. noreply@mail.tillforty.com).
RESEND_API_KEY=

# SMTP transport (used only when RESEND_API_KEY is unset). For Gmail/Workspace
# use an App Password, not the account password.
#
# Resend (https://resend.com) SMTP gateway, if you prefer SMTP over the API:
#   SMTP_HOST=smtp.resend.com   SMTP_PORT=587   SMTP_USERNAME=resend
#   SMTP_PASSWORD=<your Resend API key, re_...>   (send-only key is enough)
#
# INSTANT SETUP FOR NEW PROJECTS: don't hardcode the key here (it would land in
# git history and get scanned/revoked). Instead pass it at deploy time and
# start.sh seeds it into the generated .env on first run — the secret never
# enters the repo. Example:
#   SMTP_HOST=smtp.resend.com SMTP_USERNAME=resend SMTP_PASSWORD=re_... \
#   SMTP_FROM_EMAIL=noreply@mail.tillforty.com DOMAIN=app.example.com deploy
SMTP_HOST=
# 587 = STARTTLS (most common), 465 = implicit TLS/SSL, 25 = unencrypted relay.
SMTP_PORT=587
# Resend: literally the string "resend".
SMTP_USERNAME=
# Resend: your API key (re_...). Keep it out of version control.
SMTP_PASSWORD=
# Use STARTTLS (true for port 587). Set false + SMTP_SSL=true for port 465.
SMTP_STARTTLS=true
SMTP_SSL=false
# Envelope/from address shown to recipients (defaults to SMTP_USERNAME if blank).
# Resend: must be an address on a verified domain, e.g. noreply@mail.tillforty.com.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tillforty

# ── Development agent (optional) ────────────────────────────────────────
# Powers Development › Agent: a prompt becomes a branch, a PR, and — on one
# click — a merge plus a rebuild of this server.
#
# SECURITY: the runner mounts the Docker socket, which is root-equivalent
# access to this host, and it executes code written by an LLM. Leave it off
# unless you want that. The repository, GitHub token, and deploy switch are
# configured in the UI (Settings › App › Development), not here.
AGENT_ENABLED=false
# Server checkout that the Deploy button pulls and rebuilds. Must be the same
# path inside and outside the container — see docker-compose.yml.
APP_CHECKOUT_PATH=/opt/app-boilerplate
# How the PR is merged: squash | merge | rebase.
AGENT_MERGE_METHOD=squash
# Seconds a single agent run / deploy may take before it is abandoned.
AGENT_TIMEOUT=1800
AGENT_DEPLOY_TIMEOUT=1800
# Escape hatches if a CLI renames a flag. The prompt is appended after these.
# AGENT_CLAUDE_ARGS=-p --permission-mode bypassPermissions
# AGENT_CODEX_ARGS=exec --dangerously-bypass-approvals-and-sandbox

# ── n8n (optional) ──────────────────────────────────────────────────────
# Start n8n + its dedicated Postgres by running: ./start.sh --profile n8n
# or set N8N_ENABLED=true in .env and re-run start.sh.
# N8N_ENCRYPTION_KEY must be set before first boot — rotating it breaks credentials.
N8N_ENABLED=false
N8N_ENCRYPTION_KEY=CHANGE_ME
# n8n's dedicated Postgres (separate from the app DB).
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=CHANGE_ME
N8N_POSTGRES_DB=n8n
# Public-facing hostname/port for n8n (controls webhook URLs).
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Timezone for n8n schedules (e.g. Europe/Vilnius, America/New_York, UTC).
TIMEZONE=UTC
# Optional basic-auth in front of n8n UI (leave blank to disable).
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
# Webhook URLs must come from here, never hardcoded in code (backend/app/n8n.py,
# src/lib/n8n.ts). Leave blank to disable n8n calls in the app (helpers no-op).
# Root of the n8n instance, e.g. https://n8n.example.com or http://n8n:5678
N8N_BASE_URL=
# Base for production webhooks; defaults to {N8N_BASE_URL}/webhook when blank.
N8N_WEBHOOK_URL=
# Same values exposed to the browser, only if the frontend calls n8n directly.
VITE_N8N_BASE_URL=
VITE_N8N_WEBHOOK_URL=

# ── GlitchTip: self-hosted error monitoring (optional) ───────────────────
# GlitchTip is a lightweight, Sentry-API/DSN-compatible error tracker (~1GB).
# The app's Sentry SDKs (SENTRY_DSN / VITE_SENTRY_DSN below) point straight at
# it. Start it with:  ./start.sh --profile glitchtip   (or set the flag below
# and re-run start.sh). Runs its own Postgres + Redis, on its own port.
# NOTE: full self-hosted *Sentry* needs ~16GB RAM; GlitchTip is the fit here.
GLITCHTIP_ENABLED=false
# Host port for the GlitchTip UI (browse all captured errors here).
GLITCHTIP_PORT=8090
# Generated by start.sh on first run. Must be stable — changing it invalidates
# existing sessions. GLITCHTIP_POSTGRES_PASSWORD is generated too.
GLITCHTIP_SECRET_KEY=CHANGE_ME
GLITCHTIP_POSTGRES_USER=glitchtip
GLITCHTIP_POSTGRES_PASSWORD=CHANGE_ME
GLITCHTIP_POSTGRES_DB=glitchtip
# GlitchTip is reached via its published PORT — no separate subdomain/DNS/TLS.
# GLITCHTIP_DOMAIN (the DSN host + email-link host + CSRF origin) is auto-derived
# each run as http://DOMAIN:GLITCHTIP_PORT (e.g. http://app.acme.com:8090), so
# every install is reachable at its own domain:port. Falls back to localhost when
# DOMAIN is unset. Make sure GLITCHTIP_PORT is open on the host firewall.
GLITCHTIP_DOMAIN=http://localhost:8090
# Optional: to instead serve GlitchTip on a dedicated subdomain behind Caddy TLS,
# set a host here (e.g. errors.acme.com — add its DNS A record) or a full
# http(s)://host[:port]. Overrides the domain:port derivation above. Blank = port.
GLITCHTIP_PUBLIC_DOMAIN=
# First-run auto-provisioning: on ./start.sh with GlitchTip enabled, create the
# admin, org, project, DSN and API token and write SENTRY_* into .env — so error
# capture + the Development › Issues page wire up with no manual clicking. The
# admin password is generated and printed once. Set false to do it by hand.
GLITCHTIP_AUTOPROVISION=true
GLITCHTIP_ADMIN_EMAIL=
GLITCHTIP_ADMIN_PASSWORD=
GLITCHTIP_ORG_NAME=Tillforty
GLITCHTIP_PROJECT_NAME=tillforty-app
# Leave open until you've created your admin account, then set to false so the
# instance can't be signed up to by strangers.
GLITCHTIP_ENABLE_OPEN_USER_REGISTRATION=true
# Alert email delivery. Default logs to the container console. To actually send,
# use an EMAIL_URL, e.g. smtp://user:pass@smtp.host:587 (see GlitchTip docs).
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=glitchtip@localhost

# ── Error capture: Sentry SDK → GlitchTip (optional) ─────────────────────
# DSN the app SENDS errors to. Blank = capture disabled (SDKs no-op), exactly
# like n8n. After enabling GlitchTip: open its UI, create an org + project, then
# paste that project's DSN here. SENTRY_DSN is used by the backend (server-side,
# can use the internal host http://glitchtip:8080/...); VITE_SENTRY_DSN is baked
# into the browser bundle at build time so it MUST use the public GLITCHTIP_DOMAIN
# host. Changing VITE_SENTRY_DSN requires a `web` rebuild (start.sh does this).
SENTRY_DSN=
VITE_SENTRY_DSN=
# Environment tag attached to every event (production / staging / dev).
SENTRY_ENVIRONMENT=production
# ── Pulling issues INTO the app UI via the Sentry REST API ───────────────
# Powers the in-app "Development › Issues" page. The BACKEND calls this, so the
# URL must be reachable from inside the api container. Leave blank to auto-use
# the bundled GlitchTip's internal address (http://glitchtip:8080); only set it
# for an external tracker. Create a token in GlitchTip (Profile → Auth Tokens)
# and set the org + project slugs (from the project's URL/settings).
SENTRY_API_URL=
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=

# ── Backups (optional) ──────────────────────────────────────────────────
# Used by backup.sh --upload. Leave blank to skip S3 uploads.
# Works with AWS S3, Cloudflare R2, MinIO, or any S3-compatible storage.
S3_BUCKET=
S3_PREFIX=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# For non-AWS endpoints (Cloudflare R2, MinIO, etc.)
AWS_ENDPOINT_URL=

# ── Frontend (Vite) ─────────────────────────────────────────────────────
# Where the dev server proxies /api to (see vite.config.ts). The app itself
# calls the relative path /api, so nothing else is needed in production.
VITE_API_PROXY_TARGET=http://localhost:8000
